<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Marketing Agency</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
</head>
<body>
    <nav>
        <div class="container">
            <a href="/" class="logo">Vision<span>AI</span></a>
            <div class="nav-links">
                <a href="#services">Services</a>
                <a href="/login" class="btn-login">Login</a>
            </div>
        </div>
    </nav>

    <header class="hero">
        <div class="container">
            <h1>Scale Your Business with <span>AI-Powered</span> Marketing</h1>
            <p>Future-proof your brand with custom web design, rapid development, and data-driven growth strategies.</p>
            <div class="hero-btns">
                <a href="#cta" class="btn-primary">Get Started</a>
                <a href="#services" class="btn-secondary">Our Services</a>
            </div>
        </div>
    </header>

    <section id="services" class="services">
        <div class="container">
            <h2 class="section-title">What We Do</h2>
            <div class="service-grid">
                <div class="service-card">
                    <div class="icon">🎨</div>
                    <h3>Web Design</h3>
                    <p>Beautiful, high-converting interfaces crafted for your specific audience.</p>
                </div>
                <div class="service-card">
                    <div class="icon">🚀</div>
                    <h3>Development</h3>
                    <p>Bleeding-edge Node.js and React apps built for performance and scale.</p>
                </div>
                <div class="service-card">
                    <div class="icon">🧠</div>
                    <h3>AI Integration</h3>
                    <p>Automate your workflow and enhance customer experience with smart AI tools.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="cta" class="cta">
        <div class="container">
            <h2>Ready to transform your business?</h2>
            <p>Join 100+ brands reaching their full potential today.</p>
            <a href="#" class="btn-primary large">Book a Strategy Call</a>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; 2026 VisionAI Marketing. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
