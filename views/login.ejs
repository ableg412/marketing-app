<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - VisionAI</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="login-container">
        <div class="login-card">
            <h2>Admin Login</h2>
            <% if (error) { %>
                <p class="error"><%= error %></p>
            <% } %>
            <form action="/login" method="POST">
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" name="username" required placeholder="Abel">
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required placeholder="1234">
                </div>
                <button type="submit" class="btn-primary full-width">Sign In</button>
            </form>
            <p class="back-link"><a href="/">← Back to Home</a></p>
        </div>
    </div>
</body>
</html>
